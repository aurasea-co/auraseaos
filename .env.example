# AuraSea OS — environment template. Copy to .env.local and fill in.
# .env.local is gitignored; never commit real keys.

# ── Supabase ───────────────────────────────────────────────────────────────
# Project: ynzcciiuodmpejasptsv (Singapore). URL and anon key are public by
# design and ship to the browser; the service-role key never does.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Bypasses RLS entirely. Server-side only, and per CLAUDE.md only in
# /app/superadmin/** and the LINE approve endpoint. The MenuDesk scan funnel
# deliberately does NOT use it — see migration 043.
SUPABASE_SERVICE_ROLE_KEY=

# ── App ────────────────────────────────────────────────────────────────────
# Absolute origin, used to build links in LINE and email notifications.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shared secret for the /api/cron/* routes, so only the scheduler can run them.
CRON_SECRET=

# ── Anthropic ──────────────────────────────────────────────────────────────
# Powers competitor-screenshot extraction, the morning brief's action line, and
# MenuDesk's two-pass menu read. Model ids and rates: src/lib/menudesk/ai/models.ts
ANTHROPIC_API_KEY=

# ── LINE Messaging API ─────────────────────────────────────────────────────
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_OA_ID=
LINE_WEBHOOK_URL=

# ── Email ──────────────────────────────────────────────────────────────────
RESEND_API_KEY=

# ── MenuDesk scan funnel ───────────────────────────────────────────────────
# Which ChannelAdapter delivers digests and alerts: line | noop.
# Defaults to noop, so a misconfigured value sends nothing rather than pushing
# to a real restaurant owner's phone. Keep it noop in development.
CHANNEL_ADAPTER=noop
